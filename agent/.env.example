# Environment variables for Mi Portafolio Master Agent
# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# ============================================================================
# LLM PROVIDER CONFIGURATION (choose ONE)
# ============================================================================

# OpenAI Configuration (if using GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic Configuration (if using Claude 3.x)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Local LLM Configuration (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:7b

# ============================================================================
# GITHUB INTEGRATION (REQUIRED)
# ============================================================================

# GitHub Personal Access Token (PAT)
# Required for: git operations, PR creation, deployment, CI/CD automation
# Get at: https://github.com/settings/tokens/new
# Scopes needed: repo, workflow, read:user
GITHUB_TOKEN=ghp_your-token-here

# GitHub Repository (format: owner/repo)
GITHUB_REPO=Harp-Andres/mi-portafolio

# GitHub User (your GitHub username)
GITHUB_USER=Harp-Andres

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Debug Mode (enables detailed output and file logging)
DEBUG_MODE=false

# Agent Model (which LLM model to use for agent reasoning)
AGENT_MODEL=claude-3-5-sonnet-20241022

# Maximum tokens per response
AGENT_MAX_TOKENS=4096

# ============================================================================
# CI/CD CONFIGURATION
# ============================================================================

# CI Environment (development, staging, production)
CI_ENVIRONMENT=development

# Deploy Branch (which branch triggers deployments)
DEPLOY_BRANCH=main

# GitHub Pages URL (where the portfolio is hosted)
GITHUB_PAGES_URL=https://Harp-Andres.github.io/mi-portafolio

# ============================================================================
# DOCUMENT GENERATION
# ============================================================================

# Output directory for generated documents
DOCUMENTS_OUTPUT_DIR=./generated-documents

# CV Data file path (relative or absolute)
CV_DATA_FILE=./apps/api/sample-cv-data.json

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Playwright Browser Headless Mode
PLAYWRIGHT_HEADLESS=true

# Test Timeout (seconds)
TEST_TIMEOUT=30

# Test Coverage Threshold (%)
TEST_COVERAGE_THRESHOLD=65

# ============================================================================
# TELEMETRY & MONITORING
# ============================================================================

# Enable Telemetry (send usage stats)
TELEMETRY_ENABLED=false

# Telemetry Service URL (optional)
TELEMETRY_URL=https://telemetry.example.com

# ============================================================================
# ADVANCED OPTIONS
# ============================================================================

# Workspace Root (if different from repo root)
WORKSPACE_ROOT=.

# Temporary Files Directory
TEMP_DIR=./tmp

# Python Executable (for subprocess calls)
# Leave empty to auto-detect from PATH
PYTHON_EXECUTABLE=

# Node Executable (for npm/pnpm calls)
# Leave empty to auto-detect from PATH
NODE_EXECUTABLE=

# ============================================================================
# NOTES
# ============================================================================
# - Keep this file secure: add .env to .gitignore (already done)
# - Never commit actual API keys to version control
# - Use different .env files for dev/staging/production
# - Restart agent after changing .env values
# - Agent validates .env on startup and fails gracefully if keys are missing
