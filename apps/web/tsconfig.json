{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@mportafolio/api-client": ["../../packages/api-client/src"],
      "@mportafolio/api-client/*": ["../../packages/api-client/src/*"],
      "@mportafolio/core": ["../../packages/core/src"],
      "@mportafolio/core/*": ["../../packages/core/src/*"],
      "@mportafolio/ui": ["../../packages/ui/src"],
      "@mportafolio/ui/*": ["../../packages/ui/src/*"],
      "@mportafolio/config": ["../../packages/config/src"],
      "@mportafolio/config/*": ["../../packages/config/src/*"],
      "@mportafolio/backend": ["../../packages/backend/src"],
      "@mportafolio/backend/*": ["../../packages/backend/src/*"]
    }
  },
  "include": ["src/**/*", "vitest.setup.ts", "vitest.config.ts", "playwright.config.ts", "tests/e2e/**/*"],
  "exclude": ["node_modules", "dist"]
}
