{
  "name": "@mportafolio/web",
  "version": "2.0.0",
  "type": "module",
  "description": "Mi Portafolio - React 19 Professional Portfolio",
  "author": "Andrés Rodríguez Pisa",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "generate:cv": "python3 ../../scripts/hv/generate-cv-pdf.py"
  },
  "dependencies": {
    "@mportafolio/api-client": "workspace:*",
    "@mportafolio/ui": "workspace:*",
    "axios": "^1.20.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@mportafolio/core": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.0",
    "autoprefixer": "^10.5.6",
    "docx": "^9.7.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
